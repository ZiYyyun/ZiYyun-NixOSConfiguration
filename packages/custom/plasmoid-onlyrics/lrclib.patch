+    // Parse LRC text ("[mm:ss.xx] line") into time/words arrays.
+    function parseLrc(lrc) {
+        var outLyrics = []
+        var outTimes = []
+        var lines = lrc.split("\n")
+        for (var i = 0; i < lines.length; i++) {
+            var m = lines[i].match(/\[(\d+):(\d+(?:[.:]\d+)?)\]\s*(.*)/)
+            if (m && m[3]) {
+                outTimes.push(parseInt(m[1]) * 60 + parseFloat(m[2].replace(":", ".")))
+                outLyrics.push(m[3])
+            }
+        }
+        return { lyrics: outLyrics, times: outTimes }
+    }
