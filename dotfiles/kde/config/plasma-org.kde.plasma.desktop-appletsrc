# Two-panel layout (declarative):
#   bottom (Containment 2): kickerdash (fullscreen Application Dashboard) +
#     KDE Connect + icon-only task manager + media player controller +
#     pager (virtual desktop switcher, bottom-right) + edge separator.
#   top (Containment 30): window list | panel colorizer removed |
#     net speed + CPU + system tray | network + bluetooth + battery
#     (independent icons, so tray no longer shows them) + clock.
# Tray items live on the systemtray applet itself (Plasma 6 native; no
# private.systemtray containment — that was a Plasma 5 construct).
[ActionPlugins][0]
RightButton;NoModifier=org.kde.contextmenu

[ActionPlugins][1]
RightButton;NoModifier=org.kde.contextmenu

# ============================ bottom panel ============================
[Containments][2]
activityId=
formfactor=2
immutability=1
lastScreen=0
location=4
plugin=org.kde.panel
wallpaperplugin=org.kde.image

# 左下角全屏启动器：org.kde.plasma.kickerdash（Application Dashboard），
# 其 metadata 通过 X-Plasma-RootPath 复用 kicker 的 QML（含 isDash 全屏分支），
# 点击后弹出覆盖全屏的应用菜单。Alt+F1 快捷键保持。
[Containments][2][Applets][3]
immutability=1
plugin=org.kde.plasma.kickerdash

[Containments][2][Applets][3][Configuration]
PreloadWeight=100
popupHeight=507
popupWidth=639

[Containments][2][Applets][3][Configuration][ConfigDialog]
DialogHeight=540
DialogWidth=720

[Containments][2][Applets][3][Configuration][General]
applicationsDisplay=0
favoritesPortedToKAstats=true
primaryActions=3
systemFavorites=lock-screen\,logout\,save-session\,switch-user\,suspend\,hibernate\,reboot\,shutdown

[Containments][2][Applets][3][Configuration][Shortcuts]
global=Alt+F1

[Containments][2][Applets][3][Shortcuts]
global=Alt+F1

# KDE Connect (phone pairing) — left side of the taskbar
[Containments][2][Applets][74]
immutability=1
plugin=org.kde.kdeconnect

[Containments][2][Applets][52]
immutability=1
plugin=org.kde.plasma.panelspacer

[Containments][2][Applets][5]
immutability=1
plugin=org.kde.plasma.icontasks

[Containments][2][Applets][5][Configuration][General]
launchers=applications:systemsettings.desktop,applications:org.kde.discover.desktop,preferred://filemanager,preferred://browser

# media player controller (right of the taskbar)
[Containments][2][Applets][78]
immutability=1
plugin=org.kde.plasma.mediacontroller

[Containments][2][Applets][51]
immutability=1
plugin=org.kde.plasma.panelspacer

# virtual desktop switcher (bottom-right)
[Containments][2][Applets][53]
immutability=1
plugin=org.kde.plasma.pager

[Containments][2][Applets][6]
immutability=1
plugin=org.kde.plasma.marginsseparator

[Containments][2][General]
AppletOrder=3;74;52;5;78;51;53;6

